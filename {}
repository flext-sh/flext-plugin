                def _cleanup_registry_backups() -> None:
                    backup_pattern = f"{FlextPluginUtilities.Plugin.RegistryOperations.REGISTRY_FILE_NAME.split('.')[0]}.backup.*.json"
                    backup_files = list(registry_directory.glob(backup_pattern))
